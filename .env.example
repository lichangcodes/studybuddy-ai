# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vapi
NEXT_PUBLIC_VAPI_WEB_TOKEN=
# Set to true to simulate voice sessions locally without using Vapi credits
NEXT_PUBLIC_VAPI_MOCK=


# Gemini API (post-session summaries; free tier at aistudio.google.com; summaries are skipped when unset)
GEMINI_API_KEY=

# Resend (lesson summary emails; emails are skipped when unset)
RESEND_API_KEY=
# Optional: a sender on a domain verified in Resend. The default test sender only delivers to the Resend account's own address.
EMAIL_FROM=
# Optional: base URL for links in emails. Defaults to Vercel's production URL, then http://localhost:3000.
APP_URL=
